{
  "compilerOptions": {
    "target": "es2022",                                
    "module": "nodenext",                                
    "esModuleInterop": true,     
    "forceConsistentCasingInFileNames": true,           
    "strict": true,                                     
    "skipLibCheck": true,
    "outDir": "compiled",
    "moduleResolution": "nodenext"
  },

  "exclude": ["node_modules"],
  "include": ["src"]  
}
